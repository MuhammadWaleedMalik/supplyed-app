+import { BadRequestException } from '@nestjs/common';
+import { DocumentContext, DocumentVerificationStatus, Prisma } from '@prisma/client';
+
+/** Match onboarding: the newest uploaded file decides each active requirement. */
+export async function assertProfileDocumentsReady(
+  transaction: Prisma.TransactionClient,
+  userId: string,
+  context: DocumentContext,
+) {
+  const requirements = await transaction.documentRequirement.findMany({
+    where: { context, isActive: true, documentType: { isActive: true } },
+    select: {
+      isRequired: true,
+      documentType: { select: { name: true } },
+      documents: {
+        where: { userId, applicationId: null, deletedAt: null, uploadedAt: { not: null } },
+        orderBy: [{ uploadedAt: 'desc' }, { createdAt: 'desc' }, { id: 'desc' }],
+        take: 1,
+        select: { uploadedAt: true, fileKey: true, status: true },
+      },
+    },
+  });
+  const missing = requirements.filter((requirement) => {
+    const document = requirement.documents[0];
+    const needsReplacement =
+      document &&
+      (document.status === DocumentVerificationStatus.REJECTED ||
+        document.status === DocumentVerificationStatus.REQUIRES_INFO);
+    if (!requirement.isRequired && !needsReplacement) return false;
+    const ready =
+      document?.uploadedAt &&
+      document.fileKey &&
+      (document.status === DocumentVerificationStatus.PENDING ||
+        document.status === DocumentVerificationStatus.APPROVED ||
+        document.status === DocumentVerificationStatus.NOT_REQUIRED);
+    return !ready;
+  });
+  if (missing.length) {
+    throw new BadRequestException(
+      'Upload or replace these documents before submitting: ' +
+        missing.map((requirement) => requirement.documentType.name).join(', '),
+    );
+  }
+}
