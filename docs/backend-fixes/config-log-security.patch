+function readTokenSecret(name: string, fallback: string): string {
+  const secret = process.env[name]?.trim() || fallback;
+  if (process.env.NODE_ENV === 'production' && (secret.length < 32 || secret.includes('change-me-in-env'))) {
+    throw new Error(`${name} must use a strong secret of at least 32 characters in production`);
+  }
+  return secret;
+}
+
+export function accessTokenSecret(): string {
+  return readTokenSecret('JWT_SECRET', 'change-me-in-env');
+}
+
+export function refreshTokenSecret(): string {
+  return readTokenSecret('JWT_REFRESH_SECRET', `${accessTokenSecret()}-refresh`);
+}
+
+export function otpTokenSecret(): string {
+  return readTokenSecret('JWT_OTP_SECRET', `${accessTokenSecret()}-otp`);
+}
