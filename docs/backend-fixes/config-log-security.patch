@@ -0,0 +1,7 @@
+/** Keep useful route names without query values or bearer-like signatory tokens. */
+export function redactUrl(url: string): string {
+  return url
+    .split(/[?#]/, 1)[0]
+    .replace(/(\/signatory-approvals\/token\/)[^/]+/gi, '$1[REDACTED]')
+    .replace(/[\r\n]/g, '');
+}
