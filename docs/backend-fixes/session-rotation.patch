+import { Injectable } from '@nestjs/common';
+import { PrismaService } from '../../prisma/prisma.service';
+
+@Injectable()
+export class RefreshTokensRepository {
+  constructor(private readonly prisma: PrismaService) {}
+
+  findActive(id: string, userId: string, tokenHash: string) {
+    return this.prisma.refreshToken.findFirst({
+      where: { id, userId, tokenHash, revokedAt: null, expiresAt: { gt: new Date() } },
+    });
+  }
+
+  async save(
+    id: string,
+    userId: string,
+    tokenHash: string,
+    expiresAt: Date,
+    previousHash?: string,
+    expectedPassword?: string | null,
+  ): Promise<boolean> {
+    return this.prisma.$transaction(async (transaction) => {
+      // Password reset uses this same user lock before revoking refresh sessions.
+      await transaction.$queryRaw`SELECT "id" FROM "User" WHERE "id" = ${userId} FOR UPDATE`;
+      const user = await transaction.user.findUnique({
+        where: { id: userId },
+        select: { emailVerified: true, password: true },
+      });
+      if (!user?.emailVerified) return false;
+      if (expectedPassword !== undefined && user.password !== expectedPassword) return false;
+      if (previousHash) {
+        const rotated = await transaction.refreshToken.updateMany({
+          where: { id, userId, tokenHash: previousHash, revokedAt: null, expiresAt: { gt: new Date() } },
+          data: { tokenHash, expiresAt },
+        });
+        return rotated.count === 1;
+      }
+      await transaction.refreshToken.create({ data: { id, userId, tokenHash, expiresAt } });
+      return true;
+    });
+  }
+
+  revoke(id: string, userId: string) {
+    // A signed session ID also revokes a just-rotated token if logout races refresh.
+    return this.prisma.refreshToken.updateMany({
+      where: { id, userId, revokedAt: null },
+      data: { revokedAt: new Date() },
+    });
+  }
+}
