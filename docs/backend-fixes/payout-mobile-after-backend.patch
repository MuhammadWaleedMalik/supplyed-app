@@ -0,0 +1,111 @@
+import * as Keychain from 'react-native-keychain';
+import { createInstantPayout } from '../../feature/dashboard/shared/apis/paymentsApi';
+import { getCurrentSessionUser, getSessionVersion } from '../api/session';
+
+export type PendingPayout = {
+  requestId: string;
+  amountPence?: number;
+  createdAt: string;
+};
+const running = new Set<string>();
+
+function storageService() {
+  const userId = getCurrentSessionUser()?.id;
+  if (!userId) throw new Error('Sign in before withdrawing.');
+  return 'com.supplyed.payout.' + encodeURIComponent(userId);
+}
+
+function newRequestId() {
+  // This identifies a request; it is not an authentication credential.
+  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, letter => {
+    const random = Math.floor(Math.random() * 16);
+    return (letter === 'x' ? random : (random % 4) + 8).toString(16);
+  });
+}
+
+async function readSaved(service: string): Promise<PendingPayout | undefined> {
+  const saved = await Keychain.getGenericPassword({ service });
+  if (!saved) return undefined;
+  const pending = JSON.parse(saved.password) as PendingPayout;
+  if (
+    !pending ||
+    !/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(
+      pending.requestId,
+    ) ||
+    !Number.isFinite(Date.parse(pending.createdAt)) ||
+    (pending.amountPence !== undefined &&
+      (!Number.isSafeInteger(pending.amountPence) || pending.amountPence < 40))
+  )
+    throw new Error(
+      'The saved withdrawal needs support review before another can be sent.',
+    );
+  return pending;
+}
+
+export function readPendingPayout() {
+  return readSaved(storageService());
+}
+
+export function sendPayout(amountPence?: number) {
+  return submitPayout(false, amountPence);
+}
+
+export function retrySavedPayout() {
+  return submitPayout(true);
+}
+
+async function submitPayout(retry: boolean, amountPence?: number) {
+  const service = storageService();
+  const session = getSessionVersion();
+  if (running.has(service))
+    throw new Error('This withdrawal is already being sent.');
+  running.add(service);
+  try {
+    let pending = await readSaved(service);
+    if (retry && !pending)
+      throw new Error('There is no saved withdrawal to retry.');
+    if (!retry && pending)
+      throw new Error('Resolve the saved withdrawal before starting another.');
+    if (!pending) {
+      if (
+        amountPence !== undefined &&
+        (!Number.isSafeInteger(amountPence) || amountPence < 40)
+      ) {
+        throw new Error('Enter a valid withdrawal of at least GBP 0.40.');
+      }
+      pending = {
+        requestId: newRequestId(),
+        amountPence,
+        createdAt: new Date().toISOString(),
+      };
+      const saved = await Keychain.setGenericPassword(
+        'payout',
+        JSON.stringify(pending),
+        {
+          service,
+          accessible: Keychain.ACCESSIBLE.WHEN_UNLOCKED_THIS_DEVICE_ONLY,
+        },
+      );
+      if (!saved)
+        throw new Error(
+          'Unable to save the withdrawal securely. Nothing was sent.',
+        );
+    }
+    if (getSessionVersion() !== session)
+      throw new Error('Your session changed.');
+    // Do not clear on an error: a timeout, expired session or rejection during
+    // recovery cannot prove that the earlier attempt did not move money.
+    const payout = await createInstantPayout(
+      pending.amountPence,
+      pending.requestId,
+    );
+    const cleared = await Keychain.resetGenericPassword({ service });
+    if (!cleared)
+      throw new Error(
+        'Withdrawal confirmed, but its saved request could not be cleared. Retry the saved request to finish.',
+      );
+    return payout;
+  } finally {
+    running.delete(service);
+  }
+}
