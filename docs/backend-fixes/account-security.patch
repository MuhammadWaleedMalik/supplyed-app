@@ -0,0 +1,33 @@
+import { HttpException, HttpStatus } from '@nestjs/common';
+
+export function otpSendLimit() {
+  const cooldown = Number(process.env.OTP_RESEND_COOLDOWN_SECONDS);
+  const hourly = Number(process.env.OTP_MAX_SENDS_PER_HOUR);
+  return {
+    cooldownSeconds: Number.isInteger(cooldown) && cooldown >= 0 ? cooldown : 60,
+    maxPerHour: Number.isInteger(hourly) && hourly > 0 ? hourly : 5,
+  };
+}
+
+export function assertOtpSendAllowed(
+  latest: { createdAt: Date } | null,
+  sentLastHour: number,
+  limit: { cooldownSeconds: number; maxPerHour: number },
+  now: Date,
+) {
+  const wait = latest
+    ? Math.ceil((latest.createdAt.getTime() + limit.cooldownSeconds * 1000 - now.getTime()) / 1000)
+    : 0;
+  if (wait > 0) {
+    throw new HttpException(
+      'Please wait ' + wait + ' seconds before requesting another code',
+      HttpStatus.TOO_MANY_REQUESTS,
+    );
+  }
+  if (sentLastHour >= limit.maxPerHour) {
+    throw new HttpException(
+      'Too many verification codes requested; try again later',
+      HttpStatus.TOO_MANY_REQUESTS,
+    );
+  }
+}
