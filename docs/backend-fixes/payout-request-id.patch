+-- Additive only: existing payout accounts and balances are unchanged.
+CREATE TABLE "InstantPayoutRequest" (
+    "id" TEXT NOT NULL,
+    "payoutAccountId" TEXT NOT NULL,
+    "requestId" TEXT NOT NULL,
+    "requestedAmountPence" INTEGER,
+    "amountPence" INTEGER NOT NULL,
+    "stripeAccountId" TEXT NOT NULL,
+    "destinationId" TEXT NOT NULL,
+    "stripePayoutId" TEXT,
+    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "updatedAt" TIMESTAMP(3) NOT NULL,
+    CONSTRAINT "InstantPayoutRequest_pkey" PRIMARY KEY ("id")
+);
+CREATE UNIQUE INDEX "InstantPayoutRequest_payoutAccountId_requestId_key" ON "InstantPayoutRequest"("payoutAccountId", "requestId");
+CREATE UNIQUE INDEX "InstantPayoutRequest_stripePayoutId_key" ON "InstantPayoutRequest"("stripePayoutId");
+ALTER TABLE "InstantPayoutRequest" ADD CONSTRAINT "InstantPayoutRequest_payoutAccountId_fkey" FOREIGN KEY ("payoutAccountId") REFERENCES "InstructorPayoutAccount"("id") ON DELETE RESTRICT ON UPDATE CASCADE;
